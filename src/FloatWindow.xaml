<Window x:Class="LitReader.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文献助手"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Width="570" Height="340" MinWidth="340" MinHeight="240"
        WindowStartupLocation="Manual"
        SizeChanged="OnWindowSizeChanged"
        FontFamily="Bahnschrift SemiBold, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- ============ 新粗野主义 设计令牌 ============ -->
        <SolidColorBrush x:Key="Ink"    Color="#000000"/>
        <SolidColorBrush x:Key="Paper"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Cream"  Color="#FFFDF5"/>
        <SolidColorBrush x:Key="Yellow" Color="#FFE600"/>
        <SolidColorBrush x:Key="Blue"   Color="#0038FF"/>
        <SolidColorBrush x:Key="Pink"   Color="#FF3EA5"/>
        <SolidColorBrush x:Key="Mint"   Color="#00E5A0"/>
        <SolidColorBrush x:Key="Dim"    Color="#5A5A5A"/>

        <FontFamily x:Key="Display">Arial Black, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="UI">Bahnschrift SemiBold, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="Code">Cascadia Mono, Consolas</FontFamily>

        <!-- 硬偏移阴影：用实心方块实现（无模糊），可被按压态归零 -->
        <Style x:Key="HardShadow3" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="3,3,0,0"/>
        </Style>

        <!-- ============ 按钮：粗边框 + 硬阴影 + 按压归零 ============ -->
        <Style x:Key="BrutalButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3"/>
                            </Grid.RowDefinitions>

                            <!-- 硬阴影块 -->
                            <Border x:Name="Shadow" Grid.Row="0" Grid.Column="1"
                                    Grid.RowSpan="2" Grid.ColumnSpan="2"
                                    Background="{StaticResource Ink}"/>
                            <!-- 本体 -->
                            <Border x:Name="Body" Grid.Row="0" Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="2.5" Padding="9,4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <!-- 悬停描边：叠在 Border 内侧的 1px 黑线。
                                 关键：不能用「改 BorderThickness」做悬停 —— 那会改变按钮尺寸，
                                 使 StackPanel 内其它按钮被挤走，表现为整排震动。 -->
                            <Border x:Name="HoverStroke" Grid.Row="0" Grid.Column="0"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="1"
                                    Margin="2.5"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 按压：阴影归零 + 位移，干脆无缓动 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Body" Property="Margin" Value="3,3,0,0"/>
                                <Setter TargetName="HoverStroke" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- 悬停：只加描边，不改变任何尺寸 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverStroke" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 术语条右上角的「圆圈叉号」：用于快捷删除该术语 -->
        <Style x:Key="BrutalCircleButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 圆角最大 = 圆形；用独立 Border 画，避免 Border 不能裁剪子元素圆角的问题 -->
                        <Grid Width="17" Height="17">
                            <Border x:Name="Shadow" Background="{StaticResource Ink}"
                                    CornerRadius="9" Margin="1.5,1.5,0,0"/>
                            <Border x:Name="Body" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource Ink}" BorderThickness="2"
                                    CornerRadius="9" Margin="0,0,1.5,1.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource Ink}"/>
                                <Setter Property="Foreground" Value="{StaticResource Pink}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Body" Property="Margin" Value="1.5,1.5,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮（粉色方块） -->
        <Style x:Key="BrutalIconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="26" Height="24">
                            <Border x:Name="Shadow" Background="{StaticResource Ink}" Margin="2,2,0,0"/>
                            <Border x:Name="Body" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource Ink}" BorderThickness="2.5"
                                    Margin="0,0,2,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Body" Property="Margin" Value="2,2,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 滚动条：细轨道 + 圆角滑块，按交互阶段改变外观 ============
             常态几乎隐形，悬停显形，拖拽时最深 —— 与 DSH / Qoder CN 的观感一致。
             注意：WPF 的 Border 裁剪圆角子元素不可靠，圆角一律画在自身 Background 上。 -->
        <SolidColorBrush x:Key="ScrollTrack" Color="#14000000"/>
        <SolidColorBrush x:Key="ScrollThumb" Color="#40000000"/>
        <SolidColorBrush x:Key="MarkRed" Color="#FF1744"/>

        <Style x:Key="PhaseThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Background="{StaticResource ScrollThumb}"
                                CornerRadius="5" Margin="0,2"/>
                        <ControlTemplate.Triggers>
                            <!-- 悬停：变深 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#70000000"/>
                            </Trigger>
                            <!-- 拖拽：最深 + 略微加宽 -->
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#99000000"/>
                                <Setter TargetName="Bar" Property="Margin" Value="0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PhaseScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="{StaticResource ScrollTrack}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <!-- 细圆角轨道，左右留白使其比滑块窄 -->
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3" Margin="3,0"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PhaseThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外框：实心黑边 + 硬阴影 -->
    <Grid>
        <Border Background="{StaticResource Ink}" Margin="5,5,0,0"/>
        <Border x:Name="Shell" Background="{StaticResource Cream}"
                BorderBrush="{StaticResource Ink}" BorderThickness="3"
                Margin="0,0,5,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ 标题栏 ============ -->
                <Border Grid.Row="0" Background="{StaticResource Yellow}"
                        BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,3"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Height="44">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="11,0,0,0">
                            <!-- 几何标记 -->
                            <Border Width="15" Height="15" Background="{StaticResource Ink}"/>
                            <TextBlock Text="文献助手" FontFamily="{StaticResource Display}"
                                       FontSize="17" Foreground="{StaticResource Ink}"
                                       Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource Ink}" Padding="6,2" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMode" Text="文献术语"
                                           FontFamily="{StaticResource UI}" FontSize="10.5"
                                           FontWeight="Bold" Foreground="{StaticResource Yellow}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtStatus" Foreground="{StaticResource Ink}"
                                       FontFamily="{StaticResource UI}" FontSize="10.5"
                                       FontWeight="Bold" Margin="0,0,9,0"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnTerm" Content="术语本" Style="{StaticResource BrutalButton}"
                                    Background="{StaticResource Cream}" Margin="0,0,9,0"
                                    ToolTip="查看已收藏的学术术语" Click="BtnTerm_Click"/>
                            <Button x:Name="BtnNew" Content="新对话" Style="{StaticResource BrutalButton}"
                                    Background="{StaticResource Mint}" Margin="0,0,9,0"
                                    Click="BtnNew_Click"/>
                            <Button x:Name="BtnHide" Content="✕" Style="{StaticResource BrutalIconButton}"
                                    Background="{StaticResource Pink}" Click="BtnHide_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 对话区 ============ -->
                <Grid Grid.Row="1">
                    <!-- 滚动条已移除（VerticalScrollBarVisibility=Hidden 仅隐藏视觉，
                         滚轮 / 平滑滚动 / 自动跟随照常工作）；导航完全交给右侧锚点标尺 -->
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" Padding="12,10,30,10"
                                  Background="{StaticResource Paper}">
                        <StackPanel x:Name="MsgPanel"/>
                    </ScrollViewer>

                    <!-- ===== 消息锚点标尺：等距横杠，悬停变红加长，点击跳转 ===== -->
                    <Canvas x:Name="MsgMarks" Width="24" HorizontalAlignment="Right"
                            Margin="0,6,5,6" Background="Transparent"
                            MouseLeftButtonDown="MsgMarks_Click"
                            MouseMove="MsgMarks_Move"
                            MouseLeave="MsgMarks_Leave"
                            ToolTip="点击横杠跳到对应消息"/>

                    <!-- ===== 术语本面板（点标题栏「术语本」展开） ===== -->
                    <Border x:Name="TermPanel" Visibility="Collapsed"
                            Background="{StaticResource Paper}"
                            BorderBrush="{StaticResource Ink}" BorderThickness="3,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource Yellow}"
                                    BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,3"
                                    Padding="9,6">
                                <Grid>
                                    <TextBlock Text="术语本" FontFamily="{StaticResource Display}"
                                               FontSize="13" Foreground="{StaticResource Ink}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕" Style="{StaticResource BrutalIconButton}"
                                            Background="{StaticResource Paper}"
                                            HorizontalAlignment="Right" Click="BtnTermClose_Click"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          Padding="9,7,6,9">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource PhaseScrollBar}"/>
                                </ScrollViewer.Resources>
                                <StackPanel x:Name="TermList"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ 输入区（荧光粉操作台） ============ -->
                <Border x:Name="InputBar" Grid.Row="2" Background="{StaticResource Pink}"
                        BorderBrush="{StaticResource Ink}" BorderThickness="0,3,0,0" Padding="11,9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 待发送图片 -->
                        <StackPanel x:Name="AttachBar" Grid.Row="0" Orientation="Horizontal"
                                    Margin="0,0,0,8" Visibility="Collapsed">
                            <Border Background="{StaticResource Mint}" BorderBrush="{StaticResource Ink}"
                                    BorderThickness="2.5" Padding="7,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtAttach" Foreground="{StaticResource Ink}"
                                               FontFamily="{StaticResource UI}" FontSize="11"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="✕" Style="{StaticResource BrutalButton}" FontSize="10"
                                            Padding="5,1" Margin="8,0,0,0" Background="{StaticResource Pink}"
                                            Click="BtnClearImage_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 输入框：粗黑边 + 白底（黄底用在用户消息气泡上，避免同屏两处大黄） -->
                            <Border Grid.Column="0" Background="{StaticResource Paper}"
                                    BorderBrush="{StaticResource Ink}" BorderThickness="3">
                                <TextBox x:Name="Input" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Ink}"
                                         CaretBrush="{StaticResource Ink}"
                                         SelectionBrush="{StaticResource Pink}"
                                         FontFamily="{StaticResource UI}" FontSize="13"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxHeight="82" MinHeight="38"
                                         VerticalContentAlignment="Center" Padding="9,7"
                                         PreviewKeyDown="Input_PreviewKeyDown"
                                         TextChanged="Input_TextChanged"/>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="9,0,0,0"
                                        VerticalAlignment="Bottom">
                                <Button x:Name="BtnMode" Content="文献" Style="{StaticResource BrutalButton}"
                                        ToolTip="切换助手模式：文献术语 / 生活助手（上下文独立）"
                                        Click="BtnMode_Click"/>
                                <Button x:Name="BtnAttach" Content="图" Style="{StaticResource BrutalButton}"
                                        Margin="6,0,0,0" ToolTip="选择图片（Ctrl+V 可贴截图）"
                                        Click="BtnAttach_Click"/>
                                <Button x:Name="BtnPaste" Content="划词·开" Style="{StaticResource BrutalButton}"
                                        Margin="6,0,0,0" ToolTip="划词自动发问开关"
                                        Click="BtnPaste_Click"/>
                                <Button x:Name="BtnThink" Content="思考" Style="{StaticResource BrutalButton}"
                                        Margin="6,0,0,0" ToolTip="思考模式开关"
                                        Click="BtnThink_Click"/>
                                <Button x:Name="BtnVision" Content="视觉" Style="{StaticResource BrutalButton}"
                                        Margin="6,0,0,0" ToolTip="视觉模型开关（占显存更多）"
                                        Click="BtnVision_Click"/>
                                <Button x:Name="BtnSend" Content="发送 →" Style="{StaticResource BrutalButton}"
                                        Margin="6,0,0,0" Background="{StaticResource Blue}"
                                        Foreground="{StaticResource Paper}"
                                        Click="BtnSend_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
